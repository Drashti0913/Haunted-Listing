# Copy to .env and fill in. Never commit .env.

# AI Director model: set ONE of these (first one found is used)
GOOGLE_API_KEY=            # FREE: https://aistudio.google.com/apikey (Gemini free tier, no card)
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=         # paid
OLLAMA_MODEL=              # free + local, but 7B models are too weak/slow for the Director

# CoStar toolkit (get these from the CoStar team at the hackathon)
COSTAR_API_BASE=
COSTAR_API_KEY=
COSTAR_PROPERTY_PATH=/properties/{id}

# Vexcel aerial image URL template, e.g. https://.../image?lat={lat}&lng={lng}
VEXCEL_IMAGE_URL=

# Matterport Showcase SDK key (add matterport_model_id to a building record)
MATTERPORT_SDK_KEY=

# Capital One Nessie v2 (sign in with GitHub at https://v2.nessieisreal.com/account, copy the nsk_... key)
NESSIE_API_KEY=
