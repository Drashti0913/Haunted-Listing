# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Every key is optional: whatever is missing falls back (rule-based director,
# local wallet, sample buildings), so the game always runs.

# --- LangChain deepagents AI Director: set ONE model provider (first found wins) ---
# Free: https://aistudio.google.com/apikey (Gemini free tier, no card)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Paid alternative
ANTHROPIC_API_KEY=
# Local alternative (7B models are too weak/slow for the Director)
OLLAMA_MODEL=

# --- Capital One Nessie v2: sign in with GitHub at https://v2.nessieisreal.com/account ---
NESSIE_API_KEY=

# --- CoStar track (HackPrinceton): keys come from /costar-keys in the CoStar Discord channel ---
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=
# CoStar building data: unzip the CoStar hackathon kit into ./costar-kit, then run
#   .venv/bin/python scripts/build_costar_buildings.py
