# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GM_MODEL=claude-opus-5-5

# CoStar toolkit (get these from the CoStar team at the hackathon)
COSTAR_API_BASE=
COSTAR_API_KEY=
COSTAR_PROPERTY_PATH=/properties/{id}

# Vexcel aerial image URL template, e.g. https://.../image?lat={lat}&lng={lng}
VEXCEL_IMAGE_URL=

# Matterport Showcase SDK key (add matterport_model_id to a building record)
MATTERPORT_SDK_KEY=

# Capital One Nessie v2 (sign in with GitHub at https://v2.nessieisreal.com/account, copy the nsk_... key)
NESSIE_API_KEY=
